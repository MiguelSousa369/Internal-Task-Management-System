# Desenvolvimento: copiar para .env e preencher. Em produção estas variáveis vêm de deploy/.env
# (geradas pelo deploy/setup.sh / setup.ps1) — ver docs/deploy.md.

DATABASE_URL="postgresql://user:password@localhost:5432/task_management?schema=public"
JWT_SECRET="muda_isto_para_uma_string_longa_e_aleatoria_em_producao"
PORT=3000

# Opcionais
# FRONTEND_ORIGIN=http://localhost:5173   # origens permitidas por CORS (separadas por vírgula)
# TRUST_PROXY=false                       # true atrás de um reverse proxy (Caddy em produção)
# RATE_LIMIT_MAX=2000                     # pedidos por IP a cada 15 minutos
# LOGIN_RATE_LIMIT_MAX=20                 # logins falhados por IP a cada 15 minutos
